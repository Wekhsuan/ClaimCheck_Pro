# ==============================================================================
# ClaimCheck Pro 环境配置模板 (.env.example)
# 注意：严禁在此文件或 .env 中写入任何真实的 API 密钥！
# 本项目遵循零费用架构，开发者不承担用户模型费用。所有实时调用由用户在界面中自行配置。
# ==============================================================================

# 服务模式配置：mock / byok / local
DEFAULT_SERVICE_MODE=mock

# 本地工作区路径（默认自动推导为当前项目根目录）
# CLAIMCHECK_WORKSPACE=.

# 本地服务器端口
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# 用户自带 API 模式 (BYOK) 示例模板 (仅供用户本地配置，勿提交)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-placeholder-do-not-commit
# OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# 用户本地模型配置 (Local Model) 示例模板
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=qwen2.5:7b

# 用户自带搜索 API 示例模板 (Tavily/Serper/Custom)
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=tvly-placeholder-do-not-commit
