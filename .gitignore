# ==============================================================================
# ClaimCheck Pro .gitignore
# 适配 Streamlit Community Cloud 与 GitHub 开源部署
# 严格防止敏感凭证、虚拟环境、临时运行产物与用户数据提交
# ==============================================================================

# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境与本地隔离缓存 (绝对严禁提交)
.venv/
venv/
ENV/
env/
.cache/
.pytest_cache/
scratch/
logs/
*.log
output/

# Streamlit 私密配置 (严禁提交)
.streamlit/secrets.toml

# 敏感文件、密钥与环境变量 (绝对严禁提交任何真实密钥与凭证)
.env
.env.local
.env.*.local
*.key
*.pem
*.token
credentials.json
cookies.txt
*.cookie
storage_state.json

# 临时数据库与本地数据存储
*.sqlite
*.sqlite3
*.db
*.db-journal

# 用户上传临时文件与图片缓存 (云端即用即删，本地不入 Git)
uploads/
screenshots/user_uploads/
tmp/
temp/

# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.broken

# 测试与覆盖率产物
.coverage
.coverage.*
htmlcov/
reports/*.json
reports/*.xml
# Python virtual environment
.venv/
venv/

# Python caches
.cache/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Secrets and environment variables
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.key
*.pem

# Runtime-generated files
downloads/
output/
scratch/
reports/
screenshots/

# Databases and logs
*.db
*.sqlite
*.sqlite3
*.log
logs/

# User uploads and temporary files
uploads/
temp/
tmp/

# IDE and operating-system files
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Broken or local-only files
*.broken
